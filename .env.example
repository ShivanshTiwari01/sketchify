# Copy to .env on your VPS (same folder as docker-compose.yml).
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sketchify

DATABASE_URL=postgresql://user:change-me@postgres:5432/sketchify
JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_HTTP_URL=http://YOUR_VPS_IP
NEXT_PUBLIC_WS_URL=ws://YOUR_VPS_IP/ws
